  "capabilities": [
    {
      "id": "CAP-LEARN-001",
      "capability": "TrendDetection",
      "capability_version": "1.0",
      "lifecycle": "ACTIVE",
      "category": "Learning",
      "owner": "Learning",
      "criticality": "QUALITY",
      "severity": "MANDATORY",
      "description": "中期趋势发现 — 从日线结构因子中识别具有持续上涨潜力的标的",

      "model": {
        "name": "LGBM-Stock",
        "algorithm": "LightGBM Regressor (CSRank)",
        "implementation": "lgbm_strategy.py",
        "model_file": "lgbm_model_stock.pkl",
        "training_date": "2026-07-19",
        "framework": "sklearn-compatible"
      },

      "purpose": {
        "role": "trend_detection",
        "horizon": "5-20 days",
        "decision_role": "trend_evidence",
        "what_it_answers": "这只股票的趋势是否成立？"
      },

      "data_contract": {
        "source": "stock_data.parquet (QMT xtdata)",
        "frequency": "daily",
        "min_history_days": 60,
        "survivorship_correction": true
      },

      "feature_contract": {
        "source": "FactorRegistry (factor_registry.json)",
        "feature_count": 8,
        "features": [
          "bull_line", "chase_v2", "chip_v2", "defensive_v2",
          "fund_v2", "momentum_score", "qmt_composite", "trend_score"
        ],
        "feature_domain": "DailyStructural",
        "ic_verified": true,
        "missing_policy": "WARN — 缺失因子记录日志但不阻断",
        "known_gap": "17个因子在注册表中存在但计算函数不可用，当前生产中仅8因子可用"
      },

      "output_contract": {
        "type": "regression_score",
        "range": "0-100 (CSRank percentile)",
        "signal_levels": "Lv1(>=40) to Lv5(>=90)",
        "confidence_field": "score_norm (min-max normalized)",
        "outputs_to": "all_signals[sym]['lgbm'] → signal_table.json"
      },

      "production_status": {
        "signal_count_today": 50,
        "ic_5d": "from Registry",
        "last_backtest_sharpe": -18.23,
        "known_issues": [
          "17个因子缺失导致训练/预测特征不一致",
          "bull_line (IC=-0.006) 仍在特征集中",
          "模型基于7/19数据训练，Registry IC已变化"
        ]
