      "upgrade_path": {
        "priority": "P1",
        "action": "retrain_with_cleaned_features",
        "blockers": ["待 L1 Data Audit 确认因子健康后重选特征"]
      },

      "assertions": [
        {"id": "L01", "type": "FILE_EXISTS", "check": "模型文件存在", "pattern": "lgbm_model_stock.pkl"},
        {"id": "L02", "type": "PATTERN_EXISTS", "check": "默认MODEL_PATH指向Stock模型", "pattern": "lgbm_model_stock.pkl"},
        {"id": "L03", "type": "FEATURE_COUNT", "check": "训练特征数≥5", "expected": 8},
        {"id": "L04", "type": "REGISTRY_ALIGNED", "check": "所有特征在Registry中active或已声明lifecycle", "expected": "all"}
      ]
    },

    {
      "id": "CAP-LEARN-002",
      "capability": "IntradayTiming",
      "capability_version": "1.0",
      "lifecycle": "IMPLEMENTED",
      "category": "Learning",
      "owner": "Learning",
      "criticality": "QUALITY",
      "severity": "MANDATORY",
      "description": "盘中机会发现 — 从量价变化中识别正在启动的短线标的",

      "model": {
        "name": "XGBoost",
        "algorithm": "XGBoost Binary Classifier",
        "implementation": "xgb_factor_weight.py",
        "model_file": "xgb_model.json",
        "training_date": "2026-07-19",
        "framework": "sklearn-compatible"
      },

      "purpose": {
        "role": "intraday_timing",
        "horizon": "1-5 days (FORWARD_DAYS=5)",
        "decision_role": "timing_evidence",
        "what_it_answers": "这只股票是否正在启动？"
      },

      "data_contract": {
        "planned_source": "QMT Level-2 (盘口/逐笔)",
        "current_source": "L1 intraday proxies (OHLCV)",
        "status": "DEGRADED — L2 data source unavailable; running in OHLCV proxy feature mode",
        "frequency": "daily",
        "upgrade_path": "L2 microstructure when QMT L2 data pipeline ready. Do NOT retrain before L2 — current proxy mode is internally consistent (train=OHLCV, inference=OHLCV)."
      },

      "feature_contract": {
        "source": "OHLCV proxies (_compute_stock_proxies)",
        "feature_count": 8,
        "features": [
          "intraday_trend", "intraday_volatility", "intraday_composite_score",
          "intraday_momentum_5d", "intraday_volume_ratio", "intraday_momentum_10d",
          "intraday_ma60_position", "intraday_volume_flow"
        ],
        "feature_domain": "IntradayFeature",
        "ic_verified": false,
        "note": "OHLCV-derived intraday proxies — 独立于 FactorRegistry 的盘中特征域。L7-003 Step2 修复: 加 intraday_* 前缀消除同名冲突。",
        "known_redundancy": [
          "intraday_volume_flow = -intraday_volume_ratio (完全负相关)",
          "intraday_composite_score = 0.5*intraday_volume_ratio + 0.5*intraday_momentum_5d (线性组合)",
          "有效独立维度约5"
        ]
      },

      "output_contract": {
        "type": "binary_classification_probability",
        "range": "0-100 (probability × 100)",
        "training_target": "FORWARD_DAYS=5, TOP_PCT=0.2 (top 20% = 1)",
        "score_distribution": "std≈1.1 — 概率聚集在50附近，区分度弱",
        "signal_levels": "Lv1(>=40) to Lv5(>=90)",
        "outputs_to": "all_signals[sym]['xgb'] → signal_table.json"
      },

      "production_status": {
        "signal_count_today": 30,
        "score_range_today": "59.8 ~ 67.0",
        "score_std": 1.1,
        "known_issues": [
          "训练为二分类器(top20%)，非回归模型，概率天然聚集",
          "L2数据源缺失 — 使用OHLCV代理替代原设计 (status: DEGRADED)",
          "intraday_volume_flow与intraday_volume_ratio完全负相关 — 冗余特征",
          "Linear combo: intraday_composite_score = 0.5*vol_ratio + 0.5*mom_5d"
        ]
      },

      "upgrade_path": {
        "priority": "P1",
        "action": "establish_capability_identity_then_retrain",
        "steps": [
          "1. 确认XGBoost身份: Intraday Timing (非Trend)",
          "2. 定义Timing专用特征域 (区分于Trend特征)",
          "3. 若L2仍不可用 → 从L1中选择盘中敏感因子 (量比/换手/波动等)",
          "4. 重训模型，改为回归目标或更细粒度的分类",
          "5. 更新Capability Contract至ACTIVE"
        ],
        "blockers": ["需先完成Capability身份确认"]
      },

      "assertions": [
        {"id": "L10", "type": "FILE_EXISTS", "check": "模型文件存在", "pattern": "xgb_model.json"},
        {"id": "L11", "type": "PATTERN_EXISTS", "check": "特征管道存在", "pattern": "_compute_stock_proxies"},
        {"id": "L12", "type": "NO_NAME_COLLISION", "check": "与FactorRegistry无同名特征", "status": "PASS — L7-003 Step2 验证"},
        {"id": "L13", "type": "FEATURE_DOMAIN", "check": "特征域声明为IntradayFeature", "expected": "IntradayFeature"}
      ]
